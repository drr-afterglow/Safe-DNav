<launch>
  <arg name="config" default="$(find dnav_controller)/config/obstacle_safety.yaml"/>
  <rosparam command="load" file="$(arg config)" ns="dnav_obstacle_safety_filter"/>
  <node pkg="dnav_controller" type="dnav_obstacle_safety_filter_node"
        name="dnav_obstacle_safety_filter" output="screen" required="true"/>
</launch>
