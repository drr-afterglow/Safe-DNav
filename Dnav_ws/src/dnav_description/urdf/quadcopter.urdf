<?xml version="1.0" ?>
<robot name="quadcopter">
  <material name="dnav_quadcopter_body"><color rgba="0.16 0.18 0.20 1.0"/></material>
  <material name="nuc13_charcoal"><color rgba="0.105 0.115 0.125 1.0"/></material>
  <material name="nuc13_black"><color rgba="0.018 0.020 0.022 1.0"/></material>
  <material name="nuc13_lid"><color rgba="0.17 0.18 0.19 1.0"/></material>
  <material name="nuc13_front_black"><color rgba="0.012 0.014 0.016 1.0"/></material>
  <material name="nuc13_usb_blue"><color rgba="0.02 0.22 0.72 1.0"/></material>
  <material name="nuc13_power_silver"><color rgba="0.55 0.58 0.61 1.0"/></material>
  <material name="nuc13_rubber"><color rgba="0.01 0.01 0.01 1.0"/></material>
  <material name="mid360_dark_gray"><color rgba="0.12 0.13 0.14 1.0"/></material>
  <material name="mid360_black"><color rgba="0.025 0.025 0.025 1.0"/></material>
  <material name="mid360_orange"><color rgba="1.0 0.31 0.0 1.0"/></material>
  <material name="mid360_top_gray"><color rgba="0.18 0.19 0.20 1.0"/></material>
  <link name="base_link">
    <inertial>
      <mass value="1.54"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.1152" ixy="0" ixz="0" iyy="0.1152" iyz="0" izz="0.218"/>
    </inertial>
    <collision name="quadcotper__collision">
      <origin rpy="0 0 0" xyz="0   0   -0.02"/>
      <geometry>
        <mesh filename="package://dnav_gazebo/urdf/quadcopter/meshes/CERLAB_quadcopter_clean.stl" scale="1.5 1.5 1.5"/>
      </geometry>
    </collision>
    <visual name="quadcotper__visual">
       <origin rpy="0 0 0" xyz="0   0   -0.02"/>
        <geometry>
          <mesh filename="package://dnav_gazebo/urdf/quadcopter/meshes/CERLAB_quadcopter_clean.stl" scale="1.5 1.5 1.5"/>
        </geometry>
        <material name="dnav_quadcopter_body"/>
    </visual>
  </link>

  <gazebo reference="quadcopter">
  	<material>quadcopter/Diffusion</material>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="dnav_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <!-- Gazebo's URDF fixed-joint reduction prefixes and suffixes this
             collision when nuc13_link and mid360_link are lumped. -->
        <collision>base_link_fixed_joint_lump__quadcotper__collision_collision</collision>
      </contact>
      <plugin name="dnav_contact_publisher" filename="libgazebo_ros_bumper.so">
        <bumperTopicName>/dnav/uav/contacts</bumperTopicName>
        <frameName>base_link</frameName>
      </plugin>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin name='quadcopter_gazebo_plugin' filename='libdnav_quadcopter_plugin.so'>
        <bodyName>base_link</bodyName>
        <cmdTopic>/dnav/uav/cmd_vel</cmdTopic>
        <cmdTimeout>0.5</cmdTimeout>
        <flightStateTopic>/dnav/uav/flight_state</flightStateTopic>
        <flightStatePublishPeriod>0.02</flightStatePublishPeriod>
        <rollpitchProportionalGain>10.0</rollpitchProportionalGain>
        <rollpitchDifferentialGain>5.0</rollpitchDifferentialGain>
        <rollpitchLimit>1.0</rollpitchLimit>
        <yawProportionalGain>1.5</yawProportionalGain>
        <yawDifferentialGain>1.0</yawDifferentialGain>
        <yawLimit>1.5</yawLimit>
        <yawAngleProportionalGain>3.0</yawAngleProportionalGain>
        <yawAngleLimit>3.15</yawAngleLimit>
        <velocityXYProportionalGain>5.0</velocityXYProportionalGain>
        <velocityXYDifferentialGain>2.3</velocityXYDifferentialGain>
        <velocityXYLimit>2</velocityXYLimit>
        <velocityZProportionalGain>5.0</velocityZProportionalGain>
        <velocityZDifferentialGain>0.5</velocityZDifferentialGain>
        <velocityZLimit>-1</velocityZLimit>
        <positionXYProportionalGain>1.2</positionXYProportionalGain>
        <positionXYDifferentialGain>0.1</positionXYDifferentialGain>
        <positionXYIntegralGain>0.0</positionXYIntegralGain>
        <positionXYLimit>-1</positionXYLimit>
        <positionZProportionalGain>1.0</positionZProportionalGain>
        <positionZDifferentialGain>0.2</positionZDifferentialGain>
        <positionZLimit>-1</positionZLimit>
        <accelerationXYProportionalGain>15.0</accelerationXYProportionalGain>
        <accelerationXYDifferentialGain>0.0</accelerationXYDifferentialGain>
        <accelerationXYIntegralGain>0.0</accelerationXYIntegralGain>
        <accelerationXYLimit>-1</accelerationXYLimit>
        <accelerationZProportionalGain>0.5</accelerationZProportionalGain>
        <accelerationZDifferentialGain>0.0</accelerationZDifferentialGain>
        <accelerationZLimit>-1</accelerationZLimit>
        <maxForce>60</maxForce>
        <motionSmallNoise>0.05</motionSmallNoise>
        <motionDriftNoise>0.03</motionDriftNoise>
        <motionDriftNoiseTime>5.0</motionDriftNoiseTime>
    </plugin>
  </gazebo>

  <!--
    Intel NUC 13 Pro slim chassis visual (117 x 112 x 37 mm).
    It is mounted directly above the cleaned center frame.  The negligible
    inertial values intentionally preserve the controller's tuned vehicle mass.
  -->
  <link name="nuc13_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="nuc13_pro_slim_visual">
      <geometry><mesh filename="package://dnav_gazebo/urdf/quadcopter/meshes/nuc13_pro_slim.obj"/></geometry>
    </visual>
  </link>
  <joint name="nuc13_joint" type="fixed">
    <parent link="base_link"/><child link="nuc13_link"/>
    <!-- Align with the cleaned frame deck center and rest the NUC feet on it. -->
    <origin xyz="0.01416 -0.00296 0.06820" rpy="0 0 0"/>
  </joint>
  <gazebo reference="nuc13_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <!--
    Livox Mid-360 visual approximation (65 x 65 x 60 mm overall).
    Keep this link free of collision geometry so the simulated rays cannot hit
    the sensor housing itself.  The gpu_ray origin remains at mid360_link.
  -->
  <link name="mid360_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="mid360_lower_housing">
      <origin xyz="0 0 -0.017" rpy="0 0 0"/>
      <geometry><box size="0.065 0.065 0.026"/></geometry>
      <material name="mid360_dark_gray"/>
    </visual>
    <visual name="mid360_scanner_head">
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.034"/></geometry>
      <material name="mid360_black"/>
    </visual>
    <visual name="mid360_orange_band">
      <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0327" length="0.003"/></geometry>
      <material name="mid360_orange"/>
    </visual>
    <visual name="mid360_top_cap">
      <origin xyz="0 0 0.0305" rpy="0 0 0"/>
      <geometry><cylinder radius="0.026" length="0.001"/></geometry>
      <material name="mid360_top_gray"/>
    </visual>
  </link>
  <!-- Mid-360 center stays on the NUC/frame vertical axis; its base touches the NUC lid. -->
  <joint name="mid360_joint" type="fixed"><parent link="nuc13_link"/><child link="mid360_link"/><origin xyz="0 0 0.0490" rpy="0 0 0"/></joint>
  <gazebo reference="mid360_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="mid360_link">
    <material>Gazebo/Black</material>
    <sensor name="mid360" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray><scan>
        <horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
        <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical>
      </scan><range><min>0.05</min><max>10.0</max><resolution>0.01</resolution></range>
      <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise></ray>
      <plugin name="mid360_ros_gpu_laser" filename="libgazebo_ros_gpu_laser.so">
        <robotNamespace>/dnav</robotNamespace><topicName>/dnav/uav/mid360/scan</topicName><frameName>mid360_link</frameName>
        <gaussianNoise>0.01</gaussianNoise><updateRate>10.0</updateRate><alwaysOn>true</alwaysOn>
      </plugin>
    </sensor>
  </gazebo>
</robot>
